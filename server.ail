// Mneme — Identity Vault server (RFC-001-Mneme v1.1)
//
// Phase A: health + schema + validators.
// Phase B (in progress): register (POST /api/v1/agents) — AIL #8 land (v1.73
// crypto_hash_password / crypto_verify_password, argon2id m=64MiB t=3 p=1)
// unblocked auth path. RFC-001 §5/§7.
//
// Pattern: Stoa server.ail dogfood (linear route dispatch, 3-tuple response,
// INSERT-only SQLite, latest-wins via ORDER BY rowid DESC LIMIT 1 / MAX(rowid)
// INNER JOIN). RFC-001 §4 schema, §7 API surface.

// -----------------------------------------------------------------------------
// Validators (RFC-001 §4 / §6 / §7 / §8 T8)
//
// `contains` is in spec/08-reference-card.ai.md as a stdlib utility but the
// AIL runtime executor does not register it as a builtin (v1.73 confirmed —
// stdlib/utils.ail defines it but it is not auto-imported by `ail run`).
// Use the lower-level `index_of(text, sub) -> Number` (-1 if absent) primitive
// instead — Stoa server.ail follows the same convention. Validators stay as
// plain `fn`: behaviorally pure (no `perform`) but `index_of` is not on the
// trusted-pure list.
// -----------------------------------------------------------------------------

fn _is_alnum_underscore_dash(c: Text) -> Boolean {
    // Permits A-Z a-z 0-9 _ - (single char).
    return index_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", c) >= 0
}

fn _is_lower_alnum_underscore_dash(c: Text) -> Boolean {
    return index_of("abcdefghijklmnopqrstuvwxyz0123456789_-", c) >= 0
}

fn _is_alpha(c: Text) -> Boolean {
    return index_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", c) >= 0
}

fn validate_agent_id(s: Text) -> Boolean {
    // ^[A-Za-z][A-Za-z0-9_-]{0,63}$  (RFC-001 §4)
    n = length(s)
    if n < 1 { return false }
    if n > 64 { return false }
    if not _is_alpha(slice(s, 0, 1)) { return false }
    // AIL has no `while`; tail recursion via _scan_agent_id_tail.
    return _scan_agent_id_tail(s, 1, n)
}

fn _scan_agent_id_tail(s: Text, i: Number, n: Number) -> Boolean {
    if i >= n { return true }
    if not _is_alnum_underscore_dash(slice(s, i, i + 1)) { return false }
    return _scan_agent_id_tail(s, i + 1, n)
}

fn validate_memo_slug(s: Text) -> Boolean {
    // ^[a-z0-9_-]{1,64}$  (RFC-001 §4)
    n = length(s)
    if n < 1 { return false }
    if n > 64 { return false }
    return _scan_memo_slug(s, 0, n)
}

fn _scan_memo_slug(s: Text, i: Number, n: Number) -> Boolean {
    if i >= n { return true }
    if not _is_lower_alnum_underscore_dash(slice(s, i, i + 1)) { return false }
    return _scan_memo_slug(s, i + 1, n)
}

fn validate_password(s: Text) -> Boolean {
    // RFC-001 §7 register: password length >= 12.
    return length(s) >= 12
}

fn validate_friend_status(s: Text) -> Boolean {
    return s == "active" or s == "revoked"
}

// -----------------------------------------------------------------------------
// Response helpers (3-tuple [status, content_type, body] — Stoa pattern)
// -----------------------------------------------------------------------------

fn json_ok(status: Number, body: Text) -> [Any] {
    return [status, "application/json", body]
}

fn err_json(status: Number, code: Text, message: Text) -> [Any] {
    body = join(["{\"error\":{\"code\":\"", code, "\",\"message\":\"", message, "\"}}"], "")
    return [status, "application/json", body]
}

// -----------------------------------------------------------------------------
// Env + time helpers (Stoa parity — get_db_file / now_iso patterns).
// -----------------------------------------------------------------------------

fn get_db_file() -> Text {
    r = perform env.read("MNEME_DB_FILE")
    if not is_error(r) {
        v = trim(unwrap(r))
        if v != "" { return v }
    }
    // Railway 환경 감지 — RAILWAY_ENVIRONMENT_NAME 있으면 /data 볼륨 가정.
    // 볼륨 미마운트 시 write 실패로 시끄럽게 알린다 (Stoa 패턴 정합).
    re = perform env.read("RAILWAY_ENVIRONMENT_NAME")
    if not is_error(re) {
        if trim(unwrap(re)) != "" { return "/data/mneme.db" }
    }
    return "mneme.db"
}

fn now_iso() -> Text {
    r = perform clock.now("iso")
    if is_error(r) { return "" }
    return unwrap(r)
}

// -----------------------------------------------------------------------------
// Body / JSON helpers (Stoa parity — _check_str / msg_to_json patterns).
// -----------------------------------------------------------------------------

fn _check_str(record: Any, key: Text) -> Any {
    v = get(record, key)
    if v == None { return error(join([key, " required"], "")) }
    if to_text(v) == "" { return error(join([key, " must be non-empty"], "")) }
    return ok(v)
}

fn msg_to_json(msg: Any) -> Text {
    enc = encode_json(msg)
    if is_error(enc) { return "{}" }
    return unwrap(enc)
}

// -----------------------------------------------------------------------------
// Schema bootstrap (RFC-001 §4) — INSERT-only, latest-wins.
// -----------------------------------------------------------------------------

fn ensure_schema(db: Any) -> Result[Boolean] {
    // agents (v1.1: pwd_hash NULLable + CHECK)
    r1 = perform db.execute(db,
        "CREATE TABLE IF NOT EXISTS agents (agent_id TEXT PRIMARY KEY, pwd_hash TEXT, public_key TEXT, registered_at TEXT NOT NULL, CHECK (pwd_hash IS NOT NULL OR public_key IS NOT NULL)) WITHOUT ROWID",
        [])
    if is_error(r1) { return r1 }

    r2 = perform db.execute(db,
        "CREATE TABLE IF NOT EXISTS identity_versions (agent_id TEXT NOT NULL, version INTEGER NOT NULL, content TEXT NOT NULL, created_at TEXT NOT NULL, PRIMARY KEY (agent_id, version), FOREIGN KEY (agent_id) REFERENCES agents(agent_id))",
        [])
    if is_error(r2) { return r2 }
    r2b = perform db.execute(db, "CREATE INDEX IF NOT EXISTS idx_identity_latest ON identity_versions(agent_id, version DESC)", [])
    if is_error(r2b) { return r2b }

    r3 = perform db.execute(db,
        "CREATE TABLE IF NOT EXISTS bonds_entries (agent_id TEXT NOT NULL, entry_id INTEGER NOT NULL, content TEXT NOT NULL, peer_id TEXT, created_at TEXT NOT NULL, PRIMARY KEY (agent_id, entry_id))",
        [])
    if is_error(r3) { return r3 }
    r3b = perform db.execute(db, "CREATE INDEX IF NOT EXISTS idx_bonds_recent ON bonds_entries(agent_id, entry_id DESC)", [])
    if is_error(r3b) { return r3b }

    r4 = perform db.execute(db,
        "CREATE TABLE IF NOT EXISTS friendships (agent_id TEXT NOT NULL, friend_id TEXT NOT NULL, status TEXT NOT NULL CHECK (status IN ('active','revoked')), created_at TEXT NOT NULL, PRIMARY KEY (agent_id, friend_id, created_at))",
        [])
    if is_error(r4) { return r4 }
    r4b = perform db.execute(db, "CREATE INDEX IF NOT EXISTS idx_friendship_pair ON friendships(agent_id, friend_id, created_at DESC)", [])
    if is_error(r4b) { return r4b }

    r5 = perform db.execute(db,
        "CREATE TABLE IF NOT EXISTS will_versions (agent_id TEXT NOT NULL, version INTEGER NOT NULL, content TEXT NOT NULL, created_at TEXT NOT NULL, PRIMARY KEY (agent_id, version))",
        [])
    if is_error(r5) { return r5 }
    r5b = perform db.execute(db, "CREATE INDEX IF NOT EXISTS idx_will_latest ON will_versions(agent_id, version DESC)", [])
    if is_error(r5b) { return r5b }

    r6 = perform db.execute(db,
        "CREATE TABLE IF NOT EXISTS memo_versions (agent_id TEXT NOT NULL, slug TEXT NOT NULL, version INTEGER NOT NULL, content TEXT NOT NULL, created_at TEXT NOT NULL, PRIMARY KEY (agent_id, slug, version))",
        [])
    if is_error(r6) { return r6 }
    r6b = perform db.execute(db, "CREATE INDEX IF NOT EXISTS idx_memo_latest ON memo_versions(agent_id, slug, version DESC)", [])
    if is_error(r6b) { return r6b }

    return true
}

// _ensure_db: cold-start 1회 schema. state flag로 재호출 시 작업 skip
// (Stoa hotfix v3 patterns 정합). 핸들러 진입점에서 INSERT/query 직전 호출.
fn _ensure_db() -> Any {
    f = perform state.read("db.initialized")
    if not is_error(f) { if unwrap(f) == 1 { return None } }
    db = get_db_file()
    r = ensure_schema(db)
    if is_error(r) { return r }
    perform state.write("db.initialized", 1)
    return None
}

// -----------------------------------------------------------------------------
// Handlers
// -----------------------------------------------------------------------------

fn handle_health(req: Any) -> [Any] {
    return json_ok(200, "{\"status\":\"ok\",\"version\":\"1.0.0-phaseB-step1-register\"}")
}

fn handle_not_implemented(req: Any) -> [Any] {
    return err_json(501, "INTERNAL", "endpoint pending — Phase B/C 진행 중")
}

// -----------------------------------------------------------------------------
// POST /api/v1/agents — register (RFC-001 §5 / §7)
//
// Body: { "agent_id": str, "password": str, "public_key": str? }
// Success 201: { "agent_id", "registered_at" }
// Errors: 400 invalid body / agent_id regex / password length;
//         409 agent_id 이미 존재;
//         500 hash 실패 / DB 실패.
//
// Auth: 없음 (open registration). 사람 운영자가 CLI/web prompt에서 agent_id +
// password 등록. ed25519 only path는 별도 trip 자리 — 본 endpoint는 password
// mandatory (RFC §5 Auth path 매트릭스 1번 row, public_key 옵션).
// -----------------------------------------------------------------------------
fn handle_register(req: Any) -> [Any] {
    ed = _ensure_db()
    if is_error(ed) { return err_json(500, "INTERNAL", "schema bootstrap failed") }

    parsed = parse_json(req.body)
    if is_error(parsed) { return err_json(400, "INVALID_BODY", "invalid JSON body") }
    body = unwrap(parsed)

    a = _check_str(body, "agent_id")
    if is_error(a) { return err_json(400, "INVALID_BODY", unwrap_error(a)) }
    p = _check_str(body, "password")
    if is_error(p) { return err_json(400, "INVALID_BODY", unwrap_error(p)) }

    agent_id = to_text(unwrap(a))
    password = to_text(unwrap(p))

    if not validate_agent_id(agent_id) {
        return err_json(400, "INVALID_AGENT_ID", "agent_id must match ^[A-Za-z][A-Za-z0-9_-]{0,63}$")
    }
    if not validate_password(password) {
        return err_json(400, "INVALID_PASSWORD", "password length must be >= 12")
    }

    // public_key optional — accept opaque string if provided. ed25519 hex
    // shape 검증은 후속 trip (RFC §5 ed25519 path 활성 시) 자리.
    public_key_raw = get(body, "public_key")
    public_key = ""
    if public_key_raw != None {
        public_key = to_text(public_key_raw)
    }

    db = get_db_file()
    existing_r = perform db.query(db,
        "SELECT agent_id FROM agents WHERE agent_id = ? LIMIT 1",
        [agent_id])
    if is_error(existing_r) {
        return err_json(500, "INTERNAL", join(["db query failed: ", to_text(unwrap_error(existing_r))], ""))
    }
    if length(unwrap(existing_r)) > 0 {
        return err_json(409, "AGENT_EXISTS", "agent_id already registered")
    }

    hash_r = crypto_hash_password(password)
    if is_error(hash_r) {
        return err_json(500, "INTERNAL", "password hash failed")
    }
    pwd_hash = unwrap(hash_r)

    ts = now_iso()
    pk_col = None
    if public_key != "" { pk_col = public_key }
    ins = perform db.execute(db,
        "INSERT INTO agents (agent_id, pwd_hash, public_key, registered_at) VALUES (?, ?, ?, ?)",
        [agent_id, pwd_hash, pk_col, ts])
    if is_error(ins) {
        return err_json(500, "INTERNAL", "db insert failed")
    }

    out = make_record([
        ["agent_id", agent_id],
        ["registered_at", ts]
    ])
    return json_ok(201, msg_to_json(out))
}

// -----------------------------------------------------------------------------
// Router (RFC-001 §7 — linear if/else on method+path; Stoa pattern)
// -----------------------------------------------------------------------------

fn route(req: Any) -> [Any] {
    method = req.method
    path = req.path

    if method == "GET" and path == "/api/v1/health" { return handle_health(req) }

    // Phase A — auth-bearing endpoints stub. Land progressively in Phase B/C
    // once AIL #8 (argon2id) provides crypto_hash_password / crypto_verify_password.
    if method == "POST" and path == "/api/v1/agents"   { return handle_register(req) }
    if method == "POST" and path == "/api/v1/identity" { return handle_not_implemented(req) }
    if method == "POST" and path == "/api/v1/will"     { return handle_not_implemented(req) }
    if method == "POST" and path == "/api/v1/bonds"    { return handle_not_implemented(req) }
    if method == "POST" and path == "/api/v1/memo"     { return handle_not_implemented(req) }
    if method == "POST" and path == "/api/v1/friends"  { return handle_not_implemented(req) }
    if method == "GET"  and starts_with(path, "/api/v1/identity/") { return handle_not_implemented(req) }
    if method == "GET"  and starts_with(path, "/api/v1/will/")     { return handle_not_implemented(req) }
    if method == "GET"  and starts_with(path, "/api/v1/bonds/")    { return handle_not_implemented(req) }
    if method == "GET"  and starts_with(path, "/api/v1/memo/")     { return handle_not_implemented(req) }
    if method == "GET"  and starts_with(path, "/api/v1/wake/")     { return handle_not_implemented(req) }

    return err_json(404, "NOT_FOUND", "no route")
}

// -----------------------------------------------------------------------------
// Entry — server lifecycle (RFC-001 §10 mapping)
// -----------------------------------------------------------------------------

// Schema bootstrap intentionally NOT in `when boot()` — AIL MVP evolve only
// recognizes canonical event names (`request_received`, ...). Unknown events
// have their bodies parsed as evolve action declarations (spec/04 §4) and
// reject local bindings. Phase A endpoints (/health) are DB-free; the first
// DB-touching endpoint in Phase B will call `ensure_schema(db_path)` lazily
// before its first INSERT (idempotent CREATE IF NOT EXISTS).

evolve mneme_server {
    listen: 8091
    effects: [http.respond, db.execute, db.query, clock.now, env.read, state.read, state.write]
    metric: error_rate
    rollback_on: error_rate > 0.9
    history: keep_last 100

    when request_received(req) {
        result = route(req)
        perform http.respond(get(result, 0), get(result, 1), get(result, 2))
    }
}
